# LLM 提供方：deepseek 或 openai
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 语音转写
# local：本地 faster-whisper，默认，无需任何 API Key
# openai：调用 OpenAI Whisper，需要 OPENAI_API_KEY
ASR_BACKEND=local
# auto：有 NVIDIA GPU 用 medium，否则用 small
# 也可显式指定 tiny / base / small / medium / large-v3
ASR_MODEL=auto
# auto：有 GPU 用 GPU，否则 CPU；也可强制 cuda / cpu
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=float16
# 仅 ASR_BACKEND=openai 时使用
WHISPER_MODEL=whisper-1
# 留空自动检测语言，也可设为 zh / en
ASR_LANGUAGE=

# 上传限制（MB）
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_CHUNK_MB=8
